# ── Unicity Treasury Manager Agent ─ environment config ──────────────
#
# The testnet2 gateway API key is NOT a secret (per the SDK README) — it is
# published in the SDK's own .env.example and is safe in client code/docs.
# Copy this file to `.env` and fill in values.

# Network preset — keep "testnet" (this points at the v2 testnet2 gateway).
UNICITY_NETWORK=testnet

# Gateway (oracle) API key for send / mint / payment operations on testnet2.
# Get the published testnet2 key from the SDK repo's .env.example:
# https://github.com/unicity-sphere/sphere-sdk/blob/main/.env.example
UNICITY_API_KEY=sk_replace_with_testnet2_key

# Fixed wallet mnemonic so the agent keeps the SAME identity + nametag across
# restarts. If left blank, the agent auto-generates one on first run and saves
# it to ./wallet-data (persistent file storage), then reuses it.
WALLET_MNEMONIC=

# Human-readable nametag this agent registers (3–20 chars, lowercase
# alphanumeric / _ / -). Change this — "treasurybot" will likely be taken.
AGENT_NAMETAG=treasurybot

# ── Treasury policy (the "limits a human sets; the agent acts within") ──

# Coin symbol the treasury manages.
TREASURY_COIN=UCT

# Target balance the agent tries to maintain (human units, e.g. "1000").
TARGET_BALANCE=1000

# If balance drops below this, the agent self-mints back up to TARGET_BALANCE.
LOW_WATER_MARK=250

# Maximum amount the agent will auto-approve for a SINGLE incoming payment
# request without a human. Requests above this are auto-rejected (or could be
# queued for human review — see code).
MAX_AUTO_APPROVE=50

# Maximum total it will pay out automatically per 24h window (simple cap).
DAILY_PAYOUT_CAP=200

# How often the agent runs its treasury check loop (milliseconds).
POLL_INTERVAL_MS=30000
